# 应用基础信息
VITE_APP_TITLE=济南城市信控智能体
VITE_APP_CITY=济南市
VITE_DATA_MODE=demo

# 数据访问根路径；未来对接后端时可替换为 /api 或完整服务地址
VITE_DATA_BASE_URL=/data

# 高德地图 Web 端 JS API 配置
# 请复制本文件为 .env，并填写真实值；不要提交 .env
VITE_AMAP_KEY=your_amap_web_key
VITE_AMAP_SECURITY_CODE=your_amap_security_code
VITE_AMAP_VERSION=2.0
VITE_LOCA_VERSION=2.0.0
VITE_AMAP_STYLE=amap://styles/whitesmoke
VITE_AMAP_VIEW_MODE=2D

# 地图默认中心与诊断目标（GCJ-02）
VITE_MAP_CENTER_LNG=117.1098
VITE_MAP_CENTER_LAT=36.6632
VITE_TARGET_LNG=117.111368
VITE_TARGET_LAT=36.663092
VITE_MAP_OVERVIEW_ZOOM=15.4

# Act 1 自动演示节拍
VITE_ACT1_DETECTION_SECONDS=5
VITE_ACT1_AUTO_PROCESS_SECONDS=10
