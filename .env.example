# 信控智能体环境变量示例 - 复制为 .env 后按需填写

# Redis（工作记忆、实时状态）
REDIS_URL=redis://localhost:6379/0

# Kafka（任务与指令下发）
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TASK_TOPIC=signal-control-tasks

# 大模型（通义千问 Qwen 系列示例）
# 使用阿里云百炼 / DashScope，Key 在 https://dashscope.console.aliyun.com/ 创建
# OpenAI 兼容接口 base_url（国内华北2）：
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 与 LLM_API_KEY 二选一即可，部分 SDK 会读 DASHSCOPE_API_KEY
LLM_API_KEY=sk-9c67ebc52bf04ff3b849e3aa673781da
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 多模态/视觉（可选，Qwen-VL 等）
VL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 代码生成（可选，可用同一 base 与 key，模型名区分如 qwen-coder）
CODE_GEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 知识库 / RAG
RAG_SERVICE_URL=
VECTOR_DB_HOST=localhost

# 记忆检索
MEMORY_RETRIEVAL_URL=

# 数据库
MYSQL_URL=
# 路口信息表 lon/lat：wgs84（默认，API/地图用 GCJ-02）；若库内已是高德坐标则填 gcj02
# MYSQL_INTERSECTION_LONLAT_SRS=wgs84
NEO4J_URI=
INFLUXDB_URL=

# 人机协同阈值（置信度）
HUMAN_CONFIRM_THRESHOLD=0.6
AUTO_EXECUTE_THRESHOLD=0.9
